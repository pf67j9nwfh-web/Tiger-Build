#!/bin/sh
# Runs on Mac OS X 10.4 after Tiger Build.app is copied into place.
# Puts ppc-commander where the relay expects it: ~/ppc-commander/ppc_commander.py

SRC=""
for candidate in \
  "$2/Tiger Build.app/Contents/Resources/ppc_commander.py" \
  "$3/Applications/Tiger Build.app/Contents/Resources/ppc_commander.py" \
  "/Applications/Tiger Build.app/Contents/Resources/ppc_commander.py"
do
  if [ -f "$candidate" ]; then
    SRC="$candidate"
    break
  fi
done

if [ -z "$SRC" ]; then
  echo "Tiger Build could not find ppc_commander.py in the installed app." >&2
  exit 1
fi

install_user() {
  home="$1"
  user="$2"
  if [ -z "$home" ] || [ ! -d "$home" ]; then
    return
  fi
  if [ "$user" = "root" ] || [ "$user" = "Shared" ]; then
    return
  fi
  mkdir -p "$home/ppc-commander"
  cp "$SRC" "$home/ppc-commander/ppc_commander.py"
  chmod 755 "$home/ppc-commander/ppc_commander.py"
  if [ -f "$(dirname "$SRC")/service.py" ]; then
    cp "$(dirname "$SRC")/service.py" "$home/ppc-commander/service.py"
    chmod 755 "$home/ppc-commander/service.py"
    chown "$user" "$home/ppc-commander/service.py" || true
  fi
  chown "$user" "$home/ppc-commander" "$home/ppc-commander/ppc_commander.py" || true
  echo "Installed ppc-commander for $user at $home/ppc-commander/ppc_commander.py"
}

console=""
if [ -x /usr/bin/stat ]; then
  console=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || true)
fi
if [ -n "$console" ] && [ "$console" != "root" ] && [ "$console" != "loginwindow" ]; then
  home=""
  if [ -x /usr/bin/dscl ]; then
    home=$(/usr/bin/dscl . -read "/Users/$console" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')
  fi
  if [ -z "$home" ] || [ ! -d "$home" ]; then
    home="/Users/$console"
  fi
  install_user "$home" "$console"
fi

users_root="/Users"
if [ -n "$3" ] && [ "$3" != "/" ] && [ -d "$3/Users" ]; then
  users_root="$3/Users"
fi

for dir in "$users_root"/*; do
  if [ ! -d "$dir" ]; then
    continue
  fi
  name=$(basename "$dir")
  case "$name" in
    Shared|Deleted\ Users|.*)
      continue
      ;;
  esac
  install_user "$dir" "$name"
done

if [ -x /usr/sbin/systemsetup ]; then
  /usr/sbin/systemsetup -setremotelogin on >/dev/null 2>&1 || true
fi

exit 0

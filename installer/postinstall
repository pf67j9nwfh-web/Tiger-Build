#!/bin/bash
# The Installer shows these steps on its last page. This copy stays next to
# the relay so they can be read again later.

cat > /usr/local/tiger-build-relay/ENV-SETUP.txt << 'EOF'
Tiger Build Relay 1.2 is installed at /usr/local/tiger-build-relay.
This package does not contain API keys.

1. Make an ssh-rsa key and install it on your Tiger Mac. See RELEASE.txt.

2. As your own user, not with sudo, run:

   /usr/local/tiger-build-relay/scripts/setup.sh

   The first run writes
   ~/Library/Application Support/Tiger Build Relay/config.sh.
   Set TIGER_HOST (the Tiger Mac's address) and TIGER_USER (the account on
   it), then run setup.sh again. It starts the relay and prints the address,
   port and token. Open Tiger Build Relay from /Applications.

3. On the Tiger Mac, open Tiger Build > Preferences. Enter the relay
   address, port and token, then click Test Connection.

4. Add API keys in Preferences or in the Tiger Build Relay app. The
   Workspace ID and Local API key are optional. With no keys at all, a
   local model server such as LM Studio still works.

   Keys can instead go in /usr/local/tiger-build-relay/.env
   (see .env.example).

5. Check the relay, using the address setup.sh printed:

   curl http://THAT.ADDRESS:8765/health
EOF
chmod 644 /usr/local/tiger-build-relay/ENV-SETUP.txt
echo "Tiger Build Relay files are in /usr/local/tiger-build-relay."
echo "Then, as your own user, run: /usr/local/tiger-build-relay/scripts/setup.sh"
exit 0

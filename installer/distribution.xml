<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>Tiger Build Relay 1.3.1</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <allowed-os-versions>
        <os-version min="14.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="tigerbuildrelay"/>
        <line choice="tigerbuildrelayapp"/>
    </choices-outline>
    <choice id="tigerbuildrelay" title="Tiger Build Relay" description="The relay Tiger Build uses to reach AI services. API keys are added afterward, in Tiger Build Preferences, the Tiger Build Relay app, or .env.">
        <pkg-ref id="local.tigerbuild.relay.pkg"/>
    </choice>
    <pkg-ref id="local.tigerbuild.relay.pkg" version="1.3.1" auth="root">TigerBuildRelay-component.pkg</pkg-ref>
    <choice id="tigerbuildrelayapp" title="Tiger Build Relay app" description="Installed in /Applications.">
        <pkg-ref id="local.tigerbuild.relaygui.pkg"/>
    </choice>
    <pkg-ref id="local.tigerbuild.relaygui.pkg" version="1.3.1" auth="root">TigerBuildRelayApp-component.pkg</pkg-ref>
</installer-gui-script>


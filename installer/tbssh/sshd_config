# Tiger Build's SSH server (port 2222). It only lets computers whose public key the owner added to
# ~/Library/Application Support/Tiger Build/ssh/authorized_keys run Commander, and nothing else: no shell, no terminal, no forwarding.
# It is separate from Remote Login (port 22) and does not change it.
HostKey /usr/local/tbssh/etc/ssh_host_ed25519_key
SshdSessionPath /usr/local/tbssh/libexec/sshd-session
SshdAuthPath /usr/local/tbssh/libexec/sshd-auth
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PermitEmptyPasswords no
AuthorizedKeysFile "%h/Library/Application Support/Tiger Build/ssh/authorized_keys"
StrictModes yes
ForceCommand /usr/local/tbssh/bin/tbssh-commander
PermitTTY no
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
PermitUserRC no
LoginGraceTime 20
MaxAuthTries 3
MaxStartups 5:30:20
ClientAliveInterval 30
ClientAliveCountMax 4
LogLevel INFO

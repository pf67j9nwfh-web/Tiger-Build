# Tiger Build's SSH server (port 2222). It only lets computers whose public key the owner added to
# ~/Library/Application Support/Tiger Build/ssh/authorized_keys run Commander, and nothing else: no shell, no terminal, no forwarding.
# It is separate from Remote Login (port 22) and does not change it.
HostKey /usr/local/tbssh/etc/ssh_host_ed25519_key
SshdSessionPath /usr/local/tbssh/libexec/sshd-session
SshdAuthPath /usr/local/tbssh/libexec/sshd-auth
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin no
PermitEmptyPasswords no
# the list Tiger Build keeps (Preferences, SSH Server, Allowed Keys, or ssh-copy-id to this port) and the account's ordinary one (what ssh-copy-id to Remote Login adds)
AuthorizedKeysFile "%h/Library/Application Support/Tiger Build/ssh/authorized_keys" "%h/.ssh/authorized_keys"
StrictModes yes
ForceCommand /usr/local/tbssh/bin/tbssh-commander
PermitTTY no
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
# the one variable a client may send: the key for administrator (sudo) commands (ssh -o SendEnv=TB_SUDO_KEY)
AcceptEnv TB_SUDO_KEY
PermitUserRC no
LoginGraceTime 20
MaxAuthTries 3
MaxStartups 5:30:20
ClientAliveInterval 30
ClientAliveCountMax 4
LogLevel INFO

#!/bin/sh
# Run by the installer as root after the files are in place. The payload was packed by an ordinary account, so the server's files are made
# root's, and nothing in /usr/local/tbssh can be changed by anyone else (the helper that starts and stops the server runs as root).
D=/usr/local/tbssh
chown -R root:wheel "$D" /Library/LaunchDaemons/local.tigerbuild.sshd.plist /Library/LaunchDaemons/local.tigerbuild.sshd-shell.plist
chmod 755 "$D" "$D/sbin" "$D/bin" "$D/libexec" "$D/etc" "$D/sbin/sshd" "$D/bin/"* "$D/libexec/"*
chmod 644 "$D/etc/sshd_config" "$D/etc/sshd_config_shell" "$D/LICENSE" "$D/sshfs-LICENSE" /Library/LaunchDaemons/local.tigerbuild.sshd.plist /Library/LaunchDaemons/local.tigerbuild.sshd-shell.plist
chown -R root:admin "/Applications/Tiger Build.app" 2>/dev/null
chown -R root:wheel /Library/QuickLook/TigerBuild.qlgenerator 2>/dev/null
qlmanage -r > /dev/null 2>&1
mkdir -p /var/empty
# open Tiger Build for whoever is at the screen once the Installer window is closed (not as root, and not if the installer is run from a terminal)
U=`stat -f %Su /dev/console 2>/dev/null`
if [ -n "$U" ] && [ "$U" != root ] && ps -axco command | grep -x Installer > /dev/null 2>&1; then
  nohup sh -c "n=0; while ps -axco command | grep -x Installer > /dev/null 2>&1 && [ \$n -lt 900 ]; do sleep 1; n=\$((n+1)); done; su '$U' -c 'open \"/Applications/Tiger Build.app\"'" > /dev/null 2>&1 < /dev/null &
fi
exit 0

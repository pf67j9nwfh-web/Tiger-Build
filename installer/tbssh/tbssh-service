#!/bin/sh
# usage: tbssh-service on|off | shell-on USER... | shell-off   (run as root; Tiger Build asks for the administrator password and runs it)
# Starts or stops Tiger Build's SSH servers: the Commander one (port 2222) and, with shell-on / shell-off, the regular one (port 2223, for the named accounts). The server is a launchd job that starts a copy of sshd for each connection, and it
# must be loaded into the system's launchd (as root), not into the launchd of whoever is signed in, or sshd would run as that person and
# could not read its host key. The system's Authorization dialog runs this with root's rights but the signed-in user's launchd, so it
# first becomes root all the way (the real user id too) and, on 10.5 and later, switches into the system launchd's namespace.
# The administrator dialog starts this with the caller's environment, so before anything else runs the search path and the shell's startup
# variables are replaced; otherwise a program the caller planted in its PATH could run as root.
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH
unset IFS ENV BASH_ENV CDPATH SHELLOPTS BASHOPTS DYLD_LIBRARY_PATH DYLD_INSERT_LIBRARIES DYLD_FRAMEWORK_PATH
# everything this does is written to /var/log/tbssh-service.log (readable by administrators), and nothing goes to the caller's pipe
LOG=/var/log/tbssh-service.log
touch "$LOG" 2>/dev/null; chown root:admin "$LOG" 2>/dev/null; chmod 640 "$LOG" 2>/dev/null
exec >>"$LOG" 2>&1 </dev/null
echo "== $(date) tbssh-service $* ruid=$(id -ru) euid=$(id -u) os=$(sw_vers -productVersion 2>/dev/null)"
set -x
if [ "$(id -ru)" != 0 ]; then
  [ -z "$TBSSH_REEXEC" ] || { echo "tbssh-service could not become root" >&2; exit 1; }
  # (perl turns on taint checking when the real and effective ids differ, so the environment is replaced and the arguments checked first)
  exec /usr/bin/perl -e '%ENV = (PATH => "/usr/bin:/bin:/usr/sbin:/sbin", TBSSH_REEXEC => "1"); ($s) = shift(@ARGV) =~ m{^(/[-A-Za-z0-9_./]+)$} or die "bad path\n"; ($a) = shift(@ARGV) =~ m{^(on|off|shell-on|shell-off|smb-on|smb-off)$} or die "usage\n"; if ($a eq "smb-on") { @ARGV == 5 or die "usage\n"; ($u) = $ARGV[0] =~ m{^([A-Za-z_][-A-Za-z0-9_.]{0,31})$} or die "bad user\n"; ($f) = $ARGV[1] =~ m{^(/[^\x00-\x1f]{0,1000})$} or die "bad folder\n"; ($n) = $ARGV[2] =~ m{^([A-Za-z0-9][-A-Za-z0-9_. ]{0,39})$} or die "bad share\n"; ($r) = $ARGV[3] =~ m{^([01])$} or die "bad mode\n"; ($p) = $ARGV[4] =~ m{^([0-9]{1,5})$} or die "bad port\n"; @u = ($u, $f, $n, $r, $p); } else { @u = map { m{^([A-Za-z_][-A-Za-z0-9_.]{0,31})$} or die "bad user\n"; $1 } @ARGV; } $< = 0; $> = 0; exec "/bin/sh", $s, $a, @u' "$0" "$@"
fi
case "$1" in
  smb-on|smb-off) ;;
  *)
    for f in /usr/local/tbssh/sbin/sshd /usr/local/tbssh/libexec/sshd-session /usr/local/tbssh/libexec/sshd-auth /usr/local/tbssh/etc/sshd_config /Library/LaunchDaemons/local.tigerbuild.sshd.plist; do
      [ -f "$f" ] || { echo "Tiger Build's SSH server is not installed (missing $f)" >&2; exit 1; }
    done ;;
esac
PLIST=/Library/LaunchDaemons/local.tigerbuild.sshd.plist
SHELLPLIST=/Library/LaunchDaemons/local.tigerbuild.sshd-shell.plist
SMBPLIST=/Library/LaunchDaemons/local.tigerbuild.smbd.plist
USERS=/usr/local/tbssh/etc/shell_users.conf
KEY=/usr/local/tbssh/etc/ssh_host_ed25519_key
OS="$(sw_vers -productVersion 2>/dev/null)"
# launchctl loads into the launchd it finds from the caller's session, which for the administrator dialog is the signed-in user's. With the real
# user id and a clean environment it reaches the system's (as `sudo launchctl` in a terminal does); on 10.5 and later that is checked (the
# system's launchd has com.apple.syslogd) and, if it is not, tried again from inside the system launchd's namespace.
LC="/bin/launchctl"
in_system() {
  case "$OS" in
    10.4*) return 0 ;;
    *) /bin/launchctl list 2>/dev/null | grep -q com.apple.syslogd ;;
  esac
}
case "$1" in
  on)
    if [ ! -f "$KEY" ]; then
      /usr/local/tbssh/bin/ssh-keygen -q -t ed25519 -N '' -C tiger-build-host -f "$KEY" || exit 1
    fi
    chown root:wheel "$KEY" "$KEY.pub" && chmod 600 "$KEY" && chmod 644 "$KEY.pub"
    touch /var/log/tbsshd.log && chown root:admin /var/log/tbsshd.log && chmod 640 /var/log/tbsshd.log
    $LC unload "$PLIST"
    if in_system; then
      $LC load -w "$PLIST"
    else
      echo "not in the system launchd; trying bsexec"
      /bin/launchctl bsexec 1 /bin/launchctl unload "$PLIST"
      /bin/launchctl bsexec 1 /bin/launchctl load -w "$PLIST"
    fi
    echo "load finished: $? (system domain: $(in_system && echo yes || echo no))"
    /bin/launchctl list | grep tigerbuild
    ;;
  off)
    $LC unload -w "$PLIST"
    in_system || /bin/launchctl bsexec 1 /bin/launchctl unload -w "$PLIST"
    echo "unload finished: $?"
    ;;
  smb-on)
    # smb-on USER FOLDER SHARE READONLY PORT: Tiger Build's SMB file server, a launchd job that listens on the port as root and runs tbsmbd as USER
    shift
    SU="$1"; SF="$2"; SN="$3"; SR="$4"; SP="$5"
    [ -x /usr/local/tbssh/bin/tbsmbd ] || { echo "the file sharing server is not installed (missing /usr/local/tbssh/bin/tbsmbd)" >&2; exit 1; }
    id "$SU" >/dev/null 2>&1 || { echo "no account named $SU" >&2; exit 1; }
    [ "$(id -u "$SU")" != 0 ] || { echo "root cannot share files" >&2; exit 1; }
    [ -d "$SF" ] || { echo "$SF is not a folder" >&2; exit 1; }
    [ "$SP" -ge 1 ] && [ "$SP" -le 65535 ] || { echo "bad port" >&2; exit 1; }
    SH=$(/usr/bin/perl -e '@p = getpwnam($ARGV[0]); print $p[7]' "$SU")
    UF="$SH/Library/Application Support/Tiger Build/smb/users"
    [ -f "$UF" ] || { echo "no people are set up: $UF is missing" >&2; exit 1; }
    esc() { printf '%s' "$1" | /usr/bin/sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'; }
    {
      echo '<?xml version="1.0" encoding="UTF-8"?>'
      echo '<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
      echo '<plist version="1.0"><dict>'
      echo '<key>Label</key><string>local.tigerbuild.smbd</string>'
      echo '<key>UserName</key><string>'"$(esc "$SU")"'</string>'
      echo '<key>ProgramArguments</key><array>'
      echo '<string>/usr/local/tbssh/bin/tbsmbd</string><string>--listen-fd</string>'
      echo '<string>--root</string><string>'"$(esc "$SF")"'</string>'
      echo '<string>--share</string><string>'"$(esc "$SN")"'</string>'
      echo '<string>--users</string><string>'"$(esc "$UF")"'</string>'
      [ "$SR" = 1 ] && echo '<string>--readonly</string>'
      echo '</array>'
      echo '<key>Sockets</key><dict><key>Listeners</key><dict><key>SockServiceName</key><string>'"$SP"'</string><key>SockFamily</key><string>IPv4</string></dict></dict>'
      echo '<key>inetdCompatibility</key><dict><key>Wait</key><true/></dict>'
      echo '<key>StandardErrorPath</key><string>/var/log/tbsmbd.log</string>'
      echo '</dict></plist>'
    } > "$SMBPLIST.new" && chown root:wheel "$SMBPLIST.new" && chmod 644 "$SMBPLIST.new" && mv "$SMBPLIST.new" "$SMBPLIST"
    touch /var/log/tbsmbd.log && chown "$SU" /var/log/tbsmbd.log && chmod 640 /var/log/tbsmbd.log
    $LC unload "$SMBPLIST"
    if in_system; then
      $LC load -w "$SMBPLIST"
    else
      /bin/launchctl bsexec 1 /bin/launchctl unload "$SMBPLIST"
      /bin/launchctl bsexec 1 /bin/launchctl load -w "$SMBPLIST"
    fi
    echo "load finished: $?"
    ;;
  smb-off)
    $LC unload -w "$SMBPLIST"
    in_system || /bin/launchctl bsexec 1 /bin/launchctl unload -w "$SMBPLIST"
    rm -f "$SMBPLIST"
    echo "unload finished: $?"
    ;;
  shell-on)
    shift
    [ $# -gt 0 ] || { echo "shell-on needs at least one account name" >&2; exit 2; }
    for f in /usr/local/tbssh/etc/sshd_config_shell "$SHELLPLIST"; do
      [ -f "$f" ] || { echo "the regular SSH server is not installed (missing $f)" >&2; exit 1; }
    done
    for u in "$@"; do
      id "$u" >/dev/null 2>&1 || { echo "no account named $u" >&2; exit 1; }
      [ "$u" != root ] || { echo "root cannot be allowed" >&2; exit 1; }
    done
    echo "AllowUsers $*" > "$USERS" && chown root:wheel "$USERS" && chmod 644 "$USERS"
    if [ ! -f "$KEY" ]; then
      /usr/local/tbssh/bin/ssh-keygen -q -t ed25519 -N '' -C tiger-build-host -f "$KEY" || exit 1
    fi
    chown root:wheel "$KEY" "$KEY.pub" && chmod 600 "$KEY" && chmod 644 "$KEY.pub"
    touch /var/log/tbsshd.log && chown root:admin /var/log/tbsshd.log && chmod 640 /var/log/tbsshd.log
    $LC unload "$SHELLPLIST"
    if in_system; then
      $LC load -w "$SHELLPLIST"
    else
      /bin/launchctl bsexec 1 /bin/launchctl unload "$SHELLPLIST"
      /bin/launchctl bsexec 1 /bin/launchctl load -w "$SHELLPLIST"
    fi
    echo "load finished: $?"
    ;;
  shell-off)
    $LC unload -w "$SHELLPLIST"
    in_system || /bin/launchctl bsexec 1 /bin/launchctl unload -w "$SHELLPLIST"
    echo "unload finished: $?"
    ;;
  *)
    echo "usage: tbssh-service on|off|shell-on USER...|shell-off|smb-on USER FOLDER SHARE READONLY PORT|smb-off" >&2
    exit 2
    ;;
esac

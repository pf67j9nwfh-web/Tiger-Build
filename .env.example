# Keys for the relay on the modern Mac. Never commit the real .env.
# Tiger Build uses whichever model a chat selects. Leave a line blank to hide nothing;
# a chat that picks a model with no key gets a plain error instead of a reply.
XAI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required when the Claude key is not tied to one workspace. The id starts with wrkspc_.
ANTHROPIC_WORKSPACE_ID=
MUSE_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
# OpenAI-compatible server on this Mac, such as LM Studio. Optional key.
LOCAL_MODEL_URL=http://127.0.0.1:1234/v1
LOCAL_API_KEY=

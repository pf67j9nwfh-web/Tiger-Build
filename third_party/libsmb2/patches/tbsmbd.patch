 /*************************** server handlers *************************************************************/
+/* A server handler that fails returns -(0x10000 + the low 16 bits of an NT status of the 0xC000xxxx kind) to have that status sent instead of NOT_IMPLEMENTED
+   (Tiger Build's patch: a file server must say "not found", "access denied" and so on). */
+static int tb_srv_status(int ret)
+{
+        if (ret <= -0x10000 && ret > -0x20000) {
+                return (int)(0xC0000000u | (unsigned)(-ret - 0x10000));
+        }
+        return SMB2_STATUS_NOT_IMPLEMENTED;
+}
+

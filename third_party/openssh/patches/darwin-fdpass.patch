+/* A 64-bit program built with the 10.5 SDK lays a control message out with an 8-byte aligned header (the descriptor 16 bytes in); the kernels of
+   10.6 and later pack it (a 12-byte header, the descriptor right after) and refuse or misread the 10.5 layout, so the server could not hand a
+   terminal to its session. 10.5's own kernel wants the 10.5 layout. The layout is chosen by the system the program runs on. */
+static int
+tb_cmsg_packed(void)
+{
+	static int packed = -1;
+	struct utsname u;
+
+	if (packed < 0)
+		packed = uname(&u) == 0 && atoi(u.release) >= 10;
+	return packed;
+}
+#else
+#define tb_cmsg_packed() 0
+#endif

#!/bin/bash
# SSH to the Tiger Mac (Mac OS X 10.4, OpenSSH 5.x).
#
#   ppc-ssh                    interactive shell
#   ppc-ssh 'remote command'   one command, no tty

set -euo pipefail

# Settings (TIGER_HOST, TIGER_USER, TIGER_KEY, TIGER_KNOWN) come from $PPC_CONFIG, else ~/.config/ppc-commander/config.sh.
# The settings file of the old Tiger Build 1.x relay is still read if that is where yours is.
CONFIG="${PPC_CONFIG:-$HOME/.config/ppc-commander/config.sh}"
if [ ! -f "$CONFIG" ] && [ -f "$HOME/Library/Application Support/Tiger Build Relay/config.sh" ]; then
  CONFIG="$HOME/Library/Application Support/Tiger Build Relay/config.sh"
fi
if [ -f "$CONFIG" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG"
fi

: "${TIGER_HOST:?set TIGER_HOST in $CONFIG}"
: "${TIGER_USER:?set TIGER_USER in $CONFIG}"
TIGER_KEY="${TIGER_KEY:-$HOME/.ssh/ppc_tiger_rsa}"
TIGER_KNOWN="${TIGER_KNOWN:-$HOME/.ssh/ppc_tiger_known_hosts}"

if [ ! -f "$TIGER_KEY" ]; then
  echo "ppc-ssh: missing $TIGER_KEY" >&2
  exit 1
fi
if [ ! -f "$TIGER_KNOWN" ]; then
  echo "ppc-ssh: missing $TIGER_KNOWN" >&2
  exit 1
fi

# Tiger's OpenSSH 5.1 only signs with ssh-rsa (SHA-1), so the host key and
# user key algorithms cannot be newer. Everything else uses the strongest
# option that server offers: SHA-256 group exchange, AES-CTR, and HMAC-SHA1
# (it has no SHA-2 MACs). CBC ciphers, 3DES, MD5, and group1 are not allowed.
SSH=(
  ssh
  -i "$TIGER_KEY"
  -o IdentityAgent=none
  -o IdentitiesOnly=yes
  -o BatchMode=yes
  -o PreferredAuthentications=publickey
  -o PubkeyAuthentication=yes
  -o PubkeyAcceptedAlgorithms=ssh-rsa
  -o HostKeyAlgorithms=ssh-rsa
  -o KexAlgorithms=diffie-hellman-group-exchange-sha256,diffie-hellman-group14-sha1
  -o Ciphers=aes256-ctr,aes128-ctr
  -o MACs=hmac-sha1
  -o RequiredRSASize=2048
  -o StrictHostKeyChecking=yes
  -o "UserKnownHostsFile=$TIGER_KNOWN"
  -o UpdateHostKeys=no
  -o ConnectTimeout=15
  -o ServerAliveInterval=30
  -o ServerAliveCountMax=4
)

TARGET="$TIGER_USER@$TIGER_HOST"
if [ "$#" -eq 0 ]; then
  exec "${SSH[@]}" -t "$TARGET"
fi
# PPC_SSH_TTY=1 gives the command a terminal, for prompts such as sudo.
if [ "${PPC_SSH_TTY:-0}" = "1" ]; then
  exec "${SSH[@]}" -t "$TARGET" "$@"
fi
exec "${SSH[@]}" -T "$TARGET" "$@"

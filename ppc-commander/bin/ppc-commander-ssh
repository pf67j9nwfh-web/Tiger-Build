#!/bin/bash
# MCP stdio entry point. Nothing but the protocol may be written to stdout.
set -euo pipefail
DIR="$(cd "$(dirname "$0")" && pwd)"
# Tiger Build Relay settings. The pre-1.6 folder name (TigerDesk) still works.
RELAY_HOME="${TIGERBUILD_RELAY_HOME:-$HOME/Library/Application Support/Tiger Build Relay}"
if [ -z "${TIGERBUILD_RELAY_HOME:-}" ] && [ ! -d "$RELAY_HOME" ] && [ -d "$HOME/Library/Application Support/TigerDesk" ]; then
  RELAY_HOME="$HOME/Library/Application Support/TigerDesk"
fi
CONFIG="${TIGERBUILD_RELAY_CONFIG:-${TIGERDESK_CONFIG:-$RELAY_HOME/config.sh}}"
if [ -f "$CONFIG" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG"
fi
REMOTE_COMMANDER="${REMOTE_COMMANDER:-\$HOME/ppc-commander/ppc_commander.py}"
exec "$DIR/ppc-ssh" \
  "exec /usr/bin/env LANG=C LC_ALL=C /usr/bin/python -u $REMOTE_COMMANDER"
